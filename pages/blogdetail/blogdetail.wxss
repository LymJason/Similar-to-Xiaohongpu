.movie-container {
  display: flex;
  flex-direction: column;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
  margin-bottom: 20rpx;
}

.movie-image {
  width: 100%;
  height: 400rpx; 
  object-fit: cover;
  border-radius: 10rpx;
  margin-bottom: 20rpx;
}

.upload-btn {
  background-color: #007aff;
  color: white;
  padding: 20rpx;
  font-size: 32rpx;
  text-align: center;
  border-radius: 10rpx;
}

.movie-info {
  display: flex;
  flex-direction: column;
  padding: 10rpx 0;
}

.movie-user {
  display: flex;
  align-items: center;
  background-color: #f0f0f0;
  padding: 5px 10px; 
  border-radius: 15px; 
  margin-bottom: 10px; 
}

.movie-avatarUrl {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  flex-shrink: 0; 
}

.movie-nickName {
  font-size: 16px; 
  color: #333; 
  font-weight: bold; 
  margin-left: 10px; 
  white-space: nowrap; 
  overflow: hidden; 
  text-overflow: ellipsis; 
}

.movie-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.movie-describe {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
}

@media (max-width: 768px) {
  .movie-container {
    padding: 10rpx;
  }

  .movie-image {
    height: 300rpx; 
  }

  .movie-name {
    font-size: 32rpx;
  }

  .movie-describe {
    font-size: 24rpx;
  }
}

.input-container {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  margin-top: 20px;
  padding: 10px;
  box-sizing: border-box;
}

.comment-container {
  margin-bottom: 20rpx; 
  border-bottom: 1px solid #eee; 
}

.avatar-nickname {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
}

.nickname {
  font-size: 16px;
  color: #333;
  margin-left: 10rpx;
}

.comment-content {
  display: flex; 
  align-items: center; 
  justify-content: space-between; 
}

.info-right {
  display: flex; 
  align-items: center; 
  justify-content: flex-end; 
  flex-grow: 1; 
}

.time {
  font-size: 12px;
  color: #999;
  margin-right: 10rpx; 
}

.delete-btn {
  width: 30rpx; 
  height: 30rpx; 
  margin-right: 10rpx; 
}
.replies-container {
  margin-top: 10rpx;
}

.reply {
  margin-left: 40rpx;
}

.reply .avatar-nickname {
  display: flex;
  align-items: center;
}

.reply .avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  margin-right: 10rpx;
}

.reply .nickname {
  font-size: 12px;
  color: #666;
}

.reply .content{
  font-size: 12px;
  color: #666;
}
.reply-content{
  display: flex; 
  align-items: center; 
  justify-content: space-between;
}

.delete-btn {
  width: 30rpx; 
  height: 30rpx; 
  vertical-align: middle;
  margin-left: 10rpx; 
}

.input-container {
  position: fixed; 
  left: 0;
  bottom: 0;
  width: 100%; 
  box-sizing: border-box;
  padding: 20rpx; 
  background-color: #f8f8f8;
}

.input-bar {
  flex: 1; 
  height: 60rpx; 
  padding: 0 20rpx;
  border: 1rpx solid #ddd; 
  background-color: #fff;
  font-size: 28rpx;
}

.send-btn {
  width: 160rpx; 
  height: 60rpx; 
  margin-left: 20rpx; 
  border: none;
  background-color: #1AAD19;
  color: #fff;
  font-size: 28rpx; 
  text-align: center;
  cursor: pointer;
}

.send-btn:active {
  background-color: #179b16;
}