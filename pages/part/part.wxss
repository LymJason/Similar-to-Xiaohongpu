.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px;
  background-color: #f0f0f0;
}

.partItem {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 10px;
  padding: 15px;
  background-color: #ffffff;
  border-radius: 10px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  transition: transform 0.3s ease-in-out, box-shadow 0.3s ease-in-out;
}

.partItemHover {
  transform: translateY(-5px);
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
}

.partItemImage {
  width: 100px;
  height: 100px;
  margin-bottom: 10px;
  border-radius: 5px;
  transition: opacity 0.3s ease-in-out;
}

.partItemImage:hover {
  opacity: 0.9;
}

.text-container {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.name {
  color: #333;
  font-size: 16px;
  font-weight: bold;
  margin-bottom: 5px;
}

.rating {
  color: #666;
  font-size: 14px;
}

.bottom-button {
  width: 100%;
  margin-top: 20px;
}

.add-button {
  width: 100%;
  padding: 10px;
  background-color: #007aff;
  color: #ffffff;
  border: none;
  border-radius: 5px;
  font-size: 18px;
  cursor: pointer;
  transition: background-color 0.3s ease-in-out;
}

.add-button:hover {
  background-color: #005ecf;
}

@media screen and (max-width: 600px) {
  .partItem {
    width: 90%;
  }
  .partItemImage {
    width: 80px;
    height: 80px;
  }
}